# All env vars are optional. Defaults match Chad's 12-entry pool.
#
# Note: there is no dotenv loader. Either `export` these in your shell, or
# prefix them on the command line (e.g. `QUIPU_DB=foo.db python ...`).

# Where the SQLite DB lives (crosswalk + ledger + cache + odds, all one file).
QUIPU_DB=data/golf.db

# Season year (defaults to current year if unset).
QUIPU_SEASON=2026

# Pool config — used by the dashboard and thursday_lock.
QUIPU_POOL_ENTRIES=12
QUIPU_WEEKLY_SKINS=372.0
QUIPU_TOTAL_EVENTS=31

# Dashboard run-mode (defaults: localhost, no debug).
# Set QUIPU_HOST=0.0.0.0 to expose on the network. Set QUIPU_DEBUG=1 to
# enable the Flask debug reloader (prints a PIN — don't expose to network).
# QUIPU_HOST=127.0.0.1
# QUIPU_DEBUG=0

# Optional log file path for thursday_lock.
# QUIPU_LOG=~/quipu.log
