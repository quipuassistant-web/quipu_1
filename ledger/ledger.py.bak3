import logging
import os
import re
from pathlib import Path
from typing import Optional

logger = logging.getLogger(__name__)

LEDGER_PATH = os.path.expanduser("~/AI_HOME/AGENTS/golf/season_ledger.md")


# ---------------------------------------------------------------------------
# Parsing helpers
# ---------------------------------------------------------------------------

def _strip_markers(text: str) -> str:
    """Remove markdown bold/italics markers."""
    return re.sub(r"\*+", "", text).strip()


def _parse_winnings(s: str) -> float:
    """Parse '$169,740' → 169740.0."""
    s = s.strip()
    m = re.search(r"[\d,]+", s)
    if not m:
        return 0.0
    return float(m.group().replace(",", ""))


def _parse_finish(s: str) -> Optional[int]:
    """Parse '13' or 'T13' or 'DNF' → 13 or None."""
    s = s.strip()
    if s.upper() in ("DNF", "WD", "DNS", "CUT"):
        return None
    m = re.search(r"\d+", s)
    return int(m.group()) if m else None


# ---------------------------------------------------------------------------
# Core loaders
# ---------------------------------------------------------------------------

def load_ledger() -> list[dict]:
    """
    Parse the full Tournament Ledger table from the ledger file.

    Returns:
        [{"tournament": "...", "pick": "...", "finish": 13, "winnings": 169740.0,
          "confidence": "Med", "lesson": "Solid"}, ...]
    """
    path = Path(LEDGER_PATH)
    if not path.exists():
        logger.warning(f"Ledger file not found: {LEDGER_PATH}")
        return []

    lines = path.read_text().splitlines()

    # Find the table start: header row with '| Tournament | Pick | ...'
    header_idx = None
    for i, line in enumerate(lines):
        if "| Tournament | Pick | Finish |" in line:
            header_idx = i
            break

    if header_idx is None:
        logger.warning("Could not find Tournament Ledger table header")
        return []

    entries = []
    # Data rows start after the header + separator line (----)
    for line in lines[header_idx + 1:]:
        line = line.strip()
        if not line.startswith("|"):
            break
        # Skip separator row
        if set(line.replace("|", "").replace("-", "").replace(" ", "")) == set():
            continue

        parts = [p.strip() for p in line.split("|")]
        # parts[0] is empty before first |, parts[-1] empty after last |
        parts = parts[1:-1]  # strip leading/trailing empties
        if len(parts) < 6:
            continue

        tournament = parts[0]
        pick = parts[1]
        finish_raw = parts[2]
        winnings_raw = parts[3]
        confidence = parts[4]
        lesson = parts[5] if len(parts) > 5 else ""

        entries.append(
            {
                "tournament": tournament,
                "pick": pick,
                "finish": _parse_finish(finish_raw),
                "winnings": _parse_winnings(winnings_raw),
                "confidence": confidence,
                "lesson": lesson,
            }
        )

    logger.info(f"Loaded {len(entries)} ledger entries from {LEDGER_PATH}")
    return entries


def get_burned_ids() -> set[str]:
    """
    Return canonical player IDs that have been used (burned picks).
    Builds the set from the 'Used Picks' table in the ledger.
    """
    path = Path(LEDGER_PATH)
    if not path.exists():
        return set()

    text = path.read_text()
    burned = set()

    # Extract from 'Used Picks' table
    # e.g. "| Patrick Cantlay | AmEx | 13 | 13 | $169,740 |"
    rows = re.findall(
        r"^\| (.+?) \| (.+?) \| .+? \| .+? \|",
        text,
        re.MULTILINE,
    )
    for pick_name, _ in rows:
        name = pick_name.strip()
        # Import here to avoid circular; canonicalize lives in normalize
        try:
            from normalize.players import canonicalize
        except Exception:
            # Fallback: rough normalization
            key = "_".join(name.lower().split())
            burned.add(key)
            continue
        key = canonicalize(name)
        burned.add(key)

    # Also scan the "BURNED" sections in Available Players
    burned_pattern = re.compile(r"~~(.+?)~~", re.MULTILINE)
    for match in burned_pattern.finditer(text):
        name = match.group(1).strip()
        try:
            from normalize.players import canonicalize
        except Exception:
            key = "_".join(name.lower().split())
            burned.add(key)
            continue
        key = canonicalize(name)
        burned.add(key)

    logger.debug(f"Burned IDs: {burned}")
    return burned


def get_available_players() -> list[dict]:
    """Return canonical player dicts for all non-burned players."""
    try:
        from normalize.players import get_all_available
        return get_all_available()
    except Exception:
        return []


def get_season_summary() -> dict:
    """
    Return season totals scraped from the bold total-winnings line.
    """
    path = Path(LEDGER_PATH)
    if not path.exists():
        return {
            "total_winnings": 0.0,
            "events_completed": 0,
            "total_events": 31,
            "skins_pot": 0.0,
        }

    text = path.read_text()

    # "**Total winnings so far: $X**"
    winnings_m = re.search(r"Total winnings so far: \$([\d,]+)", text)
    total_winnings = float(winnings_m.group(1).replace(",", "")) if winnings_m else 0.0

    # Count ledger rows for events_completed
    entries = load_ledger()
    events_completed = len([e for e in entries if e.get("finish") is not None])

    return {
        "total_winnings": total_winnings,
        "events_completed": events_completed,
        "total_events": 31,
        "skins_pot": 420.50,
    }


def get_major_tracker() -> list[dict]:
    """
    Return a list of major events with pick status and outcome.
    """
    majors = [
        {"name": "Masters", "event_id": "masters_2026"},
        {"name": "PGA Championship", "event_id": "pga_championship_2026"},
        {"name": "U.S. Open", "event_id": "us_open_2026"},
        {"name": "The Open", "event_id": "the_open_2026"},
    ]

    entries = load_ledger()
    # Build tournament name → entry map
    entry_map = {e["tournament"].lower(): e for e in entries}

    results = []
    for m in majors:
        name_lower = m["name"].lower()
        # Match in ledger (fuzzy: 'masters' matches 'Masters')
        matched = None
        for ledger_name, entry in entry_map.items():
            if name_lower in ledger_name or ledger_name in name_lower:
                matched = entry
                break

        if matched:
            results.append(
                {
                    "name": m["name"],
                    "event_id": m["event_id"],
                    "pick_made": True,
                    "finish_position": matched["finish"],
                    "winnings": matched["winnings"],
                }
            )
        else:
            results.append(
                {
                    "name": m["name"],
                    "event_id": m["event_id"],
                    "pick_made": False,
                    "finish_position": None,
                    "winnings": 0.0,
                }
            )
    return results


# ---------------------------------------------------------------------------
# Writers
# ---------------------------------------------------------------------------

def append_entry(
    tournament: str,
    pick: str,
    finish: int,
    winnings: float,
    confidence: str = "Med",
    lesson: str = "",
):
    """
    Append a new row to the Tournament Ledger table and update the
    total-winnings bold line.
    """
    path = Path(LEDGER_PATH)
    if not path.exists():
        logger.error(f"Ledger file not found: {LEDGER_PATH}")
        return

    lines = path.read_text().splitlines()

    # Find last data row in the table (before '| Active Questions')
    table_end_idx = None
    for i, line in enumerate(lines):
        if "| Active Questions" in line or "## Active Questions" in line:
            table_end_idx = i
            break

    if table_end_idx is None:
        logger.error("Could not find table end marker (Active Questions header)")
        return

    # Find separator after header
    header_idx = None
    for i, line in enumerate(lines):
        if "| Tournament | Pick | Finish |" in line:
            header_idx = i
            break

    if header_idx is None:
        logger.error("Could not find table header")
        return

    # Build new row
    finish_str = str(finish) if finish is not None else "DNF"
    winnings_str = f"${winnings:,.0f}"
    new_row = f"| {tournament} | {pick} | {finish_str} | {winnings_str} | {confidence} | {lesson} |"

    # Find the last actual data row (skip separator lines and empty)
    last_data_idx = header_idx + 1
    for i in range(header_idx + 1, table_end_idx):
        line = lines[i].strip()
        if line.startswith("|") and not re.match(r"\|[ -]+\|", line):
            last_data_idx = i

    # Insert the new row
    lines.insert(last_data_idx + 1, new_row)

    # Update total winnings
    new_total_m = re.search(r"Total winnings so far: \$([\d,]+)", "".join(lines))
    if new_total_m:
        current_total = float(new_total_m.group(1).replace(",", ""))
        # The caller passes winnings already added, so just use that value to update line
        # We need to compute the new total from existing entries
        entries = load_ledger()
        total = sum(e["winnings"] for e in entries) + winnings
        # Replace the bold line
        for i, line in enumerate(lines):
            if "**Total winnings so far:" in line:
                lines[i] = re.sub(
                    r"\*\*Total winnings so far: \$[\d,]+\*\*",
                    f"**Total winnings so far: ${total:,.0f}**",
                    line,
                )
                break

    path.write_text("\n".join(lines))
    logger.info(f"Appended ledger entry: {tournament} | {pick} | {finish_str} | {winnings_str}")


def mark_burned(canonical_id: str):
    """
    Move a player from available to burned section in ledger markdown.

    Note: This is a structural change to the markdown. In practice, the
    canonical player map burned flag is the source of truth; this rewrites
    the markdown to match.
    """
    path = Path(LEDGER_PATH)
    if not path.exists():
        return

    # Import canonicalize lazily
    try:
        from normalize.players import CANONICAL_PLAYERS
    except Exception:
        logger.error("Cannot import CANONICAL_PLAYERS")
        return

    player_info = CANONICAL_PLAYERS.get(canonical_id)
    if not player_info:
        logger.warning(f"Unknown canonical_id: {canonical_id}")
        return

    display_name = player_info["display_name"]

    text = path.read_text()

    # 1. In Used Picks table, add a row for this player if not already there
    #    (This is called after a pick is made — the Used Picks table has the record)
    # 2. In Available Players section, add ~~name~~ for the player

    # Check if already marked burned
    burned_marker = f"~~{display_name}~~"
    if burned_marker in text:
        logger.debug(f"Player {canonical_id} already marked burned in ledger")
        return

    # Add burned marker in Available Players section under the right tier
    # Find the tier section and add the marker
    # Pattern: find "### Star Tier — STILL AVAILABLE" and add after the list
    # For simplicity, find the first occurrence of the display name not already burned
    # and wrap it

    # Replace "display_name" → "~~display_name~~" only if not already burned
    # Use word boundary to avoid partial matches
    pattern = re.compile(rf"({re.escape(display_name)})(?!\~\~)", re.MULTILINE)
    new_text = pattern.sub(rf"~~{display_name}~~", text, count=1)

    path.write_text(new_text)
    logger.info(f"Marked {canonical_id} as burned in ledger")