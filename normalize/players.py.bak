# ---------------------------------------------------------------------------
# Name normalization helpers
# ---------------------------------------------------------------------------

_NON_ALPHA_RE = re.compile(r"[^a-z]")


def _normalize_name(name: str) -> str:
    """Lowercase, strip, remove non-alpha characters except spaces/underscores."""
    name = name.lower().strip()
    # Keep only a-z, spaces, underscores
    return "".join(c if c.isalpha() or c in (" ", "_") else "" for c in name)


def canonicalize(name: str) -> str:
    """Normalize a player name to canonical ID.

    'Scottie Scheffler' → 'scottie_scheffler'
    'Cameron Young'     → 'cameron_young'
    """
    cleaned = _normalize_name(name)
    # Replace spaces with underscores, collapse multiple spaces to one
    parts = cleaned.split()
    key = "_".join(p for p in parts if p)
    return key


def lookup(name: str) -> Optional[dict]:
    """Look up canonical player by name (fuzzy-tolerant).

    Strategy:
    1. Exact canonicalize match
    2. Case-insensitive display_name contains
    3. First + last name match
    Returns full player dict or None.
    """
    # 1. Direct canonical ID lookup
    key = canonicalize(name)
    if key in CANONICAL_PLAYERS:
        return CANONICAL_PLAYERS[key]

    # 2. Case-insensitive contains on display_name
    name_lower = name.lower().strip()
    for pid, pinfo in CANONICAL_PLAYERS.items():
        if name_lower in pinfo["display_name"].lower():
            return pinfo

    # 3. First + last name match
    parts = name.strip().split()
    if len(parts) >= 2:
        first, last = parts[0].lower(), parts[-1].lower()
        for pid, pinfo in CANONICAL_PLAYERS.items():
            dn = pinfo["display_name"].lower()
            dn_parts = dn.split()
            if len(dn_parts) >= 2:
                dn_first, dn_last = dn_parts[0], dn_parts[-1]
                if (dn_first == first or dn_first.startswith(first)) and (
                    dn_last == last or dn_last.startswith(last)
                ):
                    return pinfo

    logger.warning(f"Player name unresolved: {name!r}")
    return None


def by_espn_id(espn_id: str) -> Optional[dict]:
    """Look up by ESPN athlete ID."""
    for pinfo in CANONICAL_PLAYERS.values():
        if pinfo.get("espn_id") == espn_id:
            return pinfo
    return None


def get_all_available() -> list[dict]:
    """Return all non-burned players (available for picks)."""
    return [p for p in CANONICAL_PLAYERS.values() if not p["burned"]]


def get_burned_players() -> set[str]:
    """Return canonical IDs of all burned players."""
    return {pid for pid, p in CANONICAL_PLAYERS.items() if p["burned"]}


def add_player(canonical_id: str, player_data: dict):
    """Add a new player to the canonical map (for rookies/invites)."""
    CANONICAL_PLAYERS[canonical_id] = {
        "id": canonical_id,
        **player_data,
    }