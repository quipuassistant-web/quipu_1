            xw.add_source_id(cid, "espn", pinfo["espn_id"])

    logger.info(f"Seeded crosswalk with {len(_seed_data)} players from ledger")


# ─────────────────────────────────────────────────────────────────────────────
# Public API (backward-compatible with old CANONICAL_PLAYERS dict)
# ─────────────────────────────────────────────────────────────────────────────

# Keep CANONICAL_PLAYERS as a class属性 for any code that still accesses it directly
# but prefer the crosswalk methods

# ─────────────────────────────────────────────────────────────────────────────
# Backward-compat: readable-keyed CANONICAL_PLAYERS (for code that needs it)
# ─────────────────────────────────────────────────────────────────────────────

def _build_readable_map() -> dict:
    """Build {readable_id: row} map from DB for code that expects scottie_scheffler keys."""
    xw = _get_crosswalk()
    result = {}
    rows = xw.conn.execute(
        "SELECT canonical_id, display_name, owgr, tier, burned FROM players"
    ).fetchall()
    for row in rows:
        rid = row["canonical_id"].replace("p_", "p").lower()  # p_00001 → p00001 ... not quite
        # Actually use display_name-based readable key
        import re
        readable = re.sub(r'[^a-z0-9]', '_', row["display_name"].lower())
        readable = re.sub(r'_+', '_', readable).strip('_')
        result[readable] = {
            "id": row["canonical_id"],
            "display_name": row["display_name"],
            "owgr": row["owgr"] or 0,
            "tier": row["tier"] or "mid",
            "burned": bool(row["burned"]),
        }
    return result


# Deprecated: use crosswalk methods directly. This is kept for backward compat
# with code that imports CANONICAL_PLAYERS directly.
CANONICAL_PLAYERS = {}  # populated lazily below


def _ensure_readable_map():
    global CANONICAL_PLAYERS
    if not CANONICAL_PLAYERS:
        CANONICAL_PLAYERS.update(_build_readable_map())


def get_readable_id(db_canonical_id: str) -> str:
    """Convert p_00001 → readable form for legacy code."""
    _ensure_readable_map()
    for rid, pinfo in CANONICAL_PLAYERS.items():
        if pinfo["id"] == db_canonical_id:
            return rid
    return db_canonical_id


# ─────────────────────────────────────────────────────────────────────────────
# Module init: ensure readable map is built on first import
# ─────────────────────────────────────────────────────────────────────────────

_ensure_readable_map()



def canonicalize(name: str) -> str:
    """Normalize a player name to canonical ID. 'Scottie Scheffler' → 'scottie_scheffler'"""
    return normalize_name(name)


def lookup(name: str) -> Optional[dict]:
    """Look up canonical player by name (fuzzy-tolerant). Returns full player dict or None."""
    xw = _get_crosswalk()
    result = xw.resolve(name, source="lookup")
    if result.canonical_id is None:
        return None
    row = xw.get_player(result.canonical_id)
    if row is None:
        return None
    return {
        "id": row["canonical_id"],
        "display_name": row["display_name"],
        "owgr": row["owgr"] if row["owgr"] is not None else 0,
        "tier": row["tier"] if row["tier"] is not None else "mid",
        "burned": bool(row["burned"]) if row["burned"] is not None else False,
    }


def by_espn_id(espn_id: str) -> Optional[dict]:
    """Look up by ESPN athlete ID."""
    xw = _get_crosswalk()
    cid = xw._lookup_by_source_id("espn", espn_id)
    if cid is None:
        return None
    row = xw.get_player(cid)
    if row is None:
        return None
    return {
        "id": row["canonical_id"],
        "display_name": row["display_name"],
        "owgr": row["owgr"] if row["owgr"] is not None else 0,
        "tier": row["tier"] if row["tier"] is not None else "mid",
        "burned": bool(row["burned"]) if row["burned"] is not None else False,
    }


def get_all_available() -> list[dict]:
    """Return all non-burned players (available for picks)."""
    xw = _get_crosswalk()
    rows = xw.conn.execute(
        "SELECT * FROM players WHERE is_active = 1 AND burned = 0"
    ).fetchall()
    # Build display_name → readable_id lookup
    _ensure_readable_map()
    name_to_readable = {v["display_name"]: k for k, v in CANONICAL_PLAYERS.items()}
    result = []
    for row in rows:
        readable_id = name_to_readable.get(row["display_name"], row["canonical_id"])
        result.append({
            "id": readable_id,
            "display_name": row["display_name"],
            "owgr": row["owgr"] if row["owgr"] is not None else 0,
            "tier": row["tier"] if row["tier"] is not None else "mid",
            "burned": bool(row["burned"]) if row["burned"] is not None else False,
        })
    return result


def get_burned_players() -> set[str]:
    """Return canonical IDs of all burned players."""
    xw = _get_crosswalk()
    rows = xw.conn.execute(
        "SELECT canonical_id FROM players WHERE burned = 1"
    ).fetchall()
    return {row["canonical_id"] for row in rows}


def add_player(canonical_id: str, player_data: dict):
    """Add a new player to the crosswalk (for rookies/invites)."""
    xw = _get_crosswalk()
    cid = xw.create_player(
        player_data.get("display_name", canonical_id),
        country=player_data.get("country"),
        birth_year=player_data.get("birth_year"),
        notes=player_data.get("notes"),
    )
    if player_data.get("espn_id"):
        xw.add_source_id(cid, "espn", player_data["espn_id"])
    return cid


def resolve(raw_name: str, source: str = "agent", source_id: str = None) -> ResolveResult:
    """Direct resolve entry point for fetchers."""
    return _get_crosswalk().resolve(raw_name, source=source, source_id=source_id)