"""
Usage: python -m golf_agent.pipeline.monday_open
Or: python golf_agent/pipeline/monday_open.py
"""
import logging
import os
from datetime import datetime

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s",
    handlers=[
        logging.FileHandler(os.path.expanduser("~/AI_HOME/LOGS/golf_agent.log")),
        logging.StreamHandler(),
    ],
)
logger = logging.getLogger(__name__)


def preview_week():
    """
    Run Monday morning preview for the upcoming tournament.
    
    Steps:
    1. Get upcoming event from normalize.events
    2. Pull DataGolf predictions (if available)
    3. Pull DraftKings odds
    4. Build player-event records for all available players
    5. Score with multi_objective.get_recommendations_for_event()
    6. Compute weekly skins breakdown
    7. Output: top 5 recommendations with full breakdown
    8. Log to golf_agent.log
    """
    from normalize.events import get_upcoming, get_event_by_date
    from normalize.players import get_all_available, get_burned_players
    from scoring.multi_objective import get_recommendations_for_event
    from scoring.skins_ev import weekly_skins_breakdown
    from fetchers.odds import get_draftkings_odds
    from ledger.ledger import get_season_summary
    
    # Get upcoming event
    upcoming = get_upcoming(n=1)
    if not upcoming:
        logger.info("No upcoming events found")
        return
    
    event = upcoming[0]
    event_id = event["id"]
    
    logger.info(f"=== MONDAY PREVIEW: {event['display_name']} ===")
    logger.info(f"Venue: {event['venue']} | Dates: {event['dates']} | Type: {event['type']}")
    
    # Get odds
    try:
        odds = get_draftkings_odds()
        logger.info(f"Pulled {len(odds)} odds lines")
    except Exception as e:
        logger.warning(f"Could not pull odds: {e}")
        odds = []
    
    # Get recommendations
    try:
        recs = get_recommendations_for_event(event_id, top_n=5)
        logger.info(f"=== TOP {len(recs)} RECOMMENDATIONS for {event['display_name']} ===")
        for i, r in enumerate(recs):
            odds_str = r.get("vegas_odds", "N/A")
            odds_pct = r.get("implied_win_pct", "N/A")
            logger.info(f"{i+1}. {r['display_name']} | Score: {r['composite_score']}/100 ({r['confidence']}) | Odds: {odds_str} (~{odds_pct}%)")
            logger.info(f"   Breakdown: {r['breakdown']}")
            if r.get("opportunity_cost"):
                logger.info(f"   ⚠️  {r['opportunity_cost']}")
            if r.get("reasoning"):
                logger.info(f"   Reasoning: {r['reasoning']}")
    except Exception as e:
        logger.error(f"Error generating recommendations: {e}")
        recs = []
    
    # Skins breakdown
    if odds:
        summary = get_season_summary()
        pot_size = summary.get("skins_pot", 420.50)
        try:
            skins = weekly_skins_breakdown(odds, pot_size=pot_size, n_entries=12)
            logger.info(f"=== SKINS POT (${pot_size:.2f}) ===")
            for row in skins[:5]:
                logger.info(f"  {row['player']}: EV ${row['skins_ev']:.2f} | solo {row['solo_prob']:.1%} | {row['n_pickers']} pickers")
        except Exception as e:
            logger.warning(f"Skins calc error: {e}")
    
    logger.info("=== PREVIEW COMPLETE ===")


if __name__ == "__main__":
    preview_week()