"""
monday_open.py — pre-tournament pipeline.

Runs Monday morning. Mirror of sunday_close. What it does:

  1. Fetch the *upcoming* PGA event from ESPN (or one specified by ID).
  2. Upsert it into the ledger with status='scheduled'.
  3. Resolve every player in the field through the crosswalk.
  4. Build the agent's working set:
       - available_players  = (every active seeded player) − (burned this season)
       - field_players      = (subset of available_players also in this week's field)
       - unresolved_in_field = players ESPN reported but our crosswalk queued
  5. Surface the unresolved queue so the user can confirm before the field locks.
  6. Print a snapshot the agent can read to plan the pick.

What it does NOT do:
  - Make the pick. That's the scorer's job (next module).
  - Lock the pick. That's thursday_lock.py / record_pick.py.

Usage:
  python monday_open.py                       # auto-detect next event
  python monday_open.py --espn-event-id 4015...
  python monday_open.py --demo                # offline self-test
"""

from __future__ import annotations

import argparse
import logging
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Optional

from normalize.players import PlayerCrosswalk
from fetchers.espn import ESPNFetcher, HTTPCache, TournamentRecord, LeaderboardRow
from ledger.ledger import Ledger
from pipeline.sunday_close import PoolConfig

logger = logging.getLogger("monday_open")


# ─────────────────────────────────────────────────────────────────────────────
# Records returned to caller
# ─────────────────────────────────────────────────────────────────────────────

@dataclass
class FieldPlayer:
    """One golfer in this week's field, joined against your roster state."""
    canonical_id: Optional[str]
    raw_name: str
    espn_athlete_id: Optional[str]
    is_burned: bool
    crosswalk_method: str
    crosswalk_confidence: float


@dataclass
class OpenResult:
    event_name: str
    event_id: str
    canonical_event_id: str
    is_major: bool
    status: str
    start_date: Optional[str]
    venue: Optional[str]
    course_name: Optional[str]
    purse: Optional[float]
    field_size: int
    available_in_field: list[FieldPlayer]
    burned_in_field: list[FieldPlayer]
    unresolved_in_field: list[FieldPlayer]
    season_picks_so_far: int
    season_burned_count: int


# ─────────────────────────────────────────────────────────────────────────────
# Pipeline
# ─────────────────────────────────────────────────────────────────────────────

def run_monday_open(
    *,
    db_path: str | Path,
    pool: PoolConfig,
    espn_event_id: Optional[str] = None,
    mock_tournament: Optional[TournamentRecord] = None,
) -> OpenResult:
    cache = HTTPCache(db_path)
    xwalk = PlayerCrosswalk(db_path)
    ledger = Ledger(db_path)
    espn = ESPNFetcher(cache, xwalk)

    try:
        # ── 1. Fetch upcoming event ────────────────────────────────────
        if mock_tournament is not None:
            tournament = mock_tournament
        else:
            tournament = espn.current_tournament()

        if tournament is None:
            raise RuntimeError(
                "No event on ESPN scoreboard. PGA off-season? Pass --espn-event-id."
            )

        if tournament.is_completed:
            logger.warning(
                "Event %s is already completed; you may want sunday_close instead.",
                tournament.espn_event_id,
            )

        # ── 2. Upsert event ────────────────────────────────────────────
        canonical_event_id = ledger.upsert_event(
            espn_event_id=tournament.espn_event_id,
            name=tournament.name,
            season=pool.season,
            start_date=tournament.start_date,
            end_date=tournament.end_date,
            venue=tournament.venue_name,
            course_name=tournament.course_name,
            purse=tournament.purse,
            status=tournament.status,
            short_name=tournament.short_name,
        )

        # ── 3. Resolve field & partition ───────────────────────────────
        burned = ledger.burned_player_ids(pool.season)

        available_in_field: list[FieldPlayer] = []
        burned_in_field: list[FieldPlayer] = []
        unresolved_in_field: list[FieldPlayer] = []

        for row in tournament.leaderboard:
            fp = FieldPlayer(
                canonical_id=row.canonical_id,
                raw_name=row.raw_name,
                espn_athlete_id=row.espn_athlete_id,
                is_burned=(row.canonical_id in burned) if row.canonical_id else False,
                crosswalk_method=row.crosswalk_method,
                crosswalk_confidence=row.crosswalk_confidence,
            )
            if fp.canonical_id is None:
                unresolved_in_field.append(fp)
            elif fp.is_burned:
                burned_in_field.append(fp)
            else:
                available_in_field.append(fp)

        # ── 4. Season context ──────────────────────────────────────────
        summary = ledger.season_summary(pool.season)

        return OpenResult(
            event_name=tournament.name,
            event_id=tournament.espn_event_id,
            canonical_event_id=canonical_event_id,
            is_major=bool(ledger.get_event(canonical_event_id)["is_major"]),
            status=tournament.status,
            start_date=tournament.start_date,
            venue=tournament.venue_name,
            course_name=tournament.course_name,
            purse=tournament.purse,
            field_size=len(tournament.leaderboard),
            available_in_field=available_in_field,
            burned_in_field=burned_in_field,
            unresolved_in_field=unresolved_in_field,
            season_picks_so_far=summary["picks_made"],
            season_burned_count=len(burned),
        )
    finally:
        cache.close()
        xwalk.close()
        ledger.close()


# ─────────────────────────────────────────────────────────────────────────────
# Pretty-print
# ─────────────────────────────────────────────────────────────────────────────

def print_summary(r: OpenResult, *, show_top_n: int = 10) -> None:
    purse_str = f"${r.purse:,.0f}" if r.purse else "?"
    print()
    print("═" * 72)
    print(f"  Upcoming: {r.event_name}{'  [MAJOR]' if r.is_major else ''}")
    print(f"  ESPN id:  {r.event_id}   status: {r.status}")
    print(f"  Dates:    {r.start_date or '?'}")
    print(f"  Venue:    {r.venue or '?'}")
    print(f"  Course:   {r.course_name or '?'}")
    print(f"  Purse:    {purse_str}")
    print(f"  Field:    {r.field_size} players")
    print(f"  Season:   {r.season_picks_so_far} picks made, "
          f"{r.season_burned_count} golfers burned")
    print("─" * 72)
    print(f"  AVAILABLE in this field: {len(r.available_in_field)}")
    print(f"  BURNED in this field:    {len(r.burned_in_field)}"
          f"  (would have been usable)")
    print(f"  UNRESOLVED in field:     {len(r.unresolved_in_field)}"
          f"  (need manual review)")
    print()

    if r.available_in_field:
        print(f"  First {min(show_top_n, len(r.available_in_field))} available "
              f"(unsorted — the scorer will rank them):")
        for fp in r.available_in_field[:show_top_n]:
            print(f"    • {fp.raw_name}  ({fp.canonical_id})")
        if len(r.available_in_field) > show_top_n:
            print(f"    … and {len(r.available_in_field) - show_top_n} more")
        print()

    if r.burned_in_field:
        print(f"  Burned (in this field, but already used):")
        for fp in r.burned_in_field:
            print(f"    • {fp.raw_name}")
        print()

    if r.unresolved_in_field:
        print(f"  Unresolved — needs your attention before Thursday lock:")
        for fp in r.unresolved_in_field:
            print(f"    • {fp.raw_name}  (espn_id={fp.espn_athlete_id})")
        print(f"  Run: python -m resolve_queue  to address these.")
        print()
    print("═" * 72)


# ─────────────────────────────────────────────────────────────────────────────
# Offline demo
# ─────────────────────────────────────────────────────────────────────────────

def _build_mock_amex_field() -> TournamentRecord:
    """The American Express field — mid-tier event, second week of season."""
    # Mix of OWGR top 200, plus a couple unresolved cases to exercise the queue
    raw_field = [
        ("9478",      "Scottie Scheffler"),
        ("4425906",   "Cameron Young"),
        ("9938",      "Sam Burns"),
        ("9143",      "Mark Hubbard"),       # 132 OWGR
        ("9843",      "Jake Knapp"),         # 62
        ("11099",     "Joaquín Niemann"),
        ("11119",     "Wyndham Clark"),
        ("4419142",   "Akshay Bhatia"),
        ("5467",      "Jordan Spieth"),
        ("9530",      "Maverick McNealy"),
        ("11250",     "Nicolai Højgaard"),
        ("4585548",   "Sami Välimäki"),
        ("10505",     "J.T. Poston"),        # BURNED — picked at Sony
        ("4348470",   "Kristoffer Reitan"),
        # Two non-seeded sponsor-invite types to exercise unresolved queue
        ("9999991",   "Brett Q. Sandstone"),
        ("9999992",   "Tomohiro Yamashita"),
    ]
    lb = [
        LeaderboardRow(
            espn_athlete_id=eid, canonical_id=None, raw_name=name,
            position=None, score_to_par=None, total_strokes=None, made_cut=None,
            earnings=None, fedex_points=None,
            crosswalk_method="", crosswalk_confidence=0.0,
        )
        for eid, name in raw_field
    ]
    return TournamentRecord(
        espn_event_id="401580352",
        name="The American Express",
        short_name="AmEx",
        start_date="2026-01-22",
        end_date="2026-01-25",
        status="scheduled",
        is_completed=False,
        venue_name="PGA West",
        venue_city="La Quinta",
        course_name="Pete Dye Stadium Course",
        purse=8800000.0,
        leaderboard=lb,
        raw_status_type="STATUS_SCHEDULED",
    )


def _demo(db_path: Path) -> None:
    """Full demo: seed + Sony close (burns Poston) + AmEx open."""
    from seed import seed, print_report
    from sunday_close import run_sunday_close, _build_mock_sony_open

    print("=" * 72)
    print(" Monday Open — Offline Demo")
    print("=" * 72)
    print()

    print("[1] Seeding crosswalk...")
    seed_report = seed(db_path)
    print(f"    Seeded {seed_report.created} players "
          f"(matched existing: {seed_report.matched_existing})")
    print()

    # Simulate the previous Sunday: close Sony Open with Poston pick
    print("[2] Pre-staging: close Sony Open with Poston pick to burn him...")
    pool = PoolConfig(season=2026, entry_count=50, weekly_skins_contribution=50.0)
    sony = _build_mock_sony_open()

    # Resolve mock leaderboard against seeded crosswalk (in real flow ESPN does this)
    xwalk = PlayerCrosswalk(db_path)
    for row in sony.leaderboard:
        r = xwalk.resolve(row.raw_name, source="espn", source_id=row.espn_athlete_id)
        row.canonical_id = r.canonical_id
        row.crosswalk_method = r.method
        row.crosswalk_confidence = r.confidence
    # Record Poston pick & event
    ledger = Ledger(db_path)
    sony_id = ledger.upsert_event(
        espn_event_id="401580351", name="Sony Open in Hawaii",
        season=2026, status="scheduled",
    )
    poston_id = xwalk.resolve("J.T. Poston", source="espn",
                              source_id="10505").canonical_id
    ledger.record_pick(season=2026, canonical_event_id=sony_id,
                       canonical_player_id=poston_id, agent_confidence="MED")
    xwalk.close()
    ledger.close()
    run_sunday_close(db_path=db_path, pool=pool,
                     pool_winners_picked=2, mock_tournament=sony)
    print("    Sony Open closed; Poston burned.")
    print()

    # Now Monday: open the AmEx
    print("[3] Running monday_open on The American Express...")
    amex = _build_mock_amex_field()
    # Pre-resolve the mock through the crosswalk (real ESPN fetcher does this)
    xwalk = PlayerCrosswalk(db_path)
    for row in amex.leaderboard:
        r = xwalk.resolve(row.raw_name, source="espn", source_id=row.espn_athlete_id)
        row.canonical_id = r.canonical_id
        row.crosswalk_method = r.method
        row.crosswalk_confidence = r.confidence
    xwalk.close()

    result = run_monday_open(db_path=db_path, pool=pool, mock_tournament=amex)
    print_summary(result, show_top_n=14)

    print()
    print("[4] Sanity checks:")
    poston_in_burned = any("Poston" in fp.raw_name for fp in result.burned_in_field)
    assert poston_in_burned, "Poston should appear in burned_in_field after Sony"
    print(f"    ✓ Poston correctly flagged as burned in this field")

    assert len(result.unresolved_in_field) == 2, \
        f"Expected 2 unresolved, got {len(result.unresolved_in_field)}"
    print(f"    ✓ Two sponsor-invite players correctly flagged for manual review")

    diacritics_resolved = any("Højgaard" in fp.raw_name or "Välimäki" in fp.raw_name
                              for fp in result.available_in_field)
    assert diacritics_resolved
    print(f"    ✓ Nordic diacritics resolved through crosswalk")

    # Event was upserted
    ledger = Ledger(db_path)
    ev = ledger.get_event(result.canonical_event_id)
    assert ev is not None
    assert ev["status"] == "scheduled"
    assert ev["venue"] == "PGA West"
    print(f"    ✓ Event upserted to ledger with status=scheduled, venue captured")
    ledger.close()


# ─────────────────────────────────────────────────────────────────────────────
# CLI
# ─────────────────────────────────────────────────────────────────────────────

def main() -> int:
    parser = argparse.ArgumentParser(description="Pre-tournament Monday-open pipeline.")
    parser.add_argument("--db", default="data/golf.db")
    parser.add_argument("--espn-event-id")
    parser.add_argument("--season", type=int, default=2026)
    parser.add_argument("--entries", type=int, default=50)
    parser.add_argument("--weekly-skins", type=float, default=50.0)
    parser.add_argument("--demo", action="store_true")
    args = parser.parse_args()

    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(name)s: %(message)s")
    db = Path(args.db)
    db.parent.mkdir(parents=True, exist_ok=True)

    if args.demo:
        if db.exists():
            db.unlink()
        _demo(db)
        return 0

    pool = PoolConfig(season=args.season, entry_count=args.entries,
                      weekly_skins_contribution=args.weekly_skins)
    result = run_monday_open(db_path=db, pool=pool, espn_event_id=args.espn_event_id)
    print_summary(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
