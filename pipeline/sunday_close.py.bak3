"""
Usage: python -m golf_agent.pipeline.sunday_close --tournament "Truist"
Or: python golf_agent/pipeline/sunday_close.py --tournament "Truist"
"""
import logging
import os
import argparse
from datetime import datetime

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s",
    handlers=[
        logging.FileHandler(os.path.expanduser("~/AI_HOME/LOGS/golf_agent.log")),
        logging.StreamHandler(),
    ],
)
logger = logging.getLogger(__name__)


def close_tournament(tournament_name: str):
    """
    Post-tournament close.
    
    Steps:
    1. Fetch final leaderboard from ESPN for the completed event
    2. Find Chad's pick in the field (from pending_pick.txt or pass as arg)
    3. Get finish position + winnings
    4. Append to ledger via ledger.append_entry()
    5. Mark player as burned
    6. Update skins pot if winner was picked
    7. Log summary
    """
    from fetchers.espn import get_tournament_results
    from ledger.ledger import append_entry, mark_burned
    from normalize.players import lookup, canonicalize
    
    logger.info(f"=== SUNDAY CLOSE: {tournament_name} ===")
    
    # Read pending pick
    pending_file = os.path.expanduser("~/AI_HOME/TOOLS/golf_agent/pending_pick.txt")
    pick_id = None
    if os.path.exists(pending_file):
        with open(pending_file, "r") as f:
            line = f.read().strip()
            if line:
                parts = line.split("|")
                if len(parts) >= 2:
                    _, pick_id, event_id_from_file = parts
                    logger.info(f"Found pending pick: {pick_id} for {event_id_from_file}")
        # Clear the file
        with open(pending_file, "w") as f:
            pass
    
    # If no pending pick, try to find it from the event
    if not pick_id:
        logger.warning("No pending pick found — skipping ledger update")
        logger.info("To log manually: python golf_agent/pipeline/sunday_close.py --tournament 'NAME' --pick 'Player Name' --finish 13 --winnings 169740")
        return
    
    # Fetch results
    try:
        results = get_tournament_results()  # would need date range
        logger.info(f"Fetched leaderboard: {len(results.get('leaderboard', []))} players")
    except Exception as e:
        logger.error(f"Error fetching results: {e}")
        results = {}
    
    # Look up player
    player = lookup(pick_id)
    if not player:
        logger.error(f"Could not find player: {pick_id}")
        return
    
    # Find in leaderboard
    pick_name = player["display_name"]
    finish = None
    winnings = 0.0
    
    # In a real run, we'd search the leaderboard for the pick
    # For now, log what we know
    logger.info(f"Pick: {pick_name} | Finish: TBD | Winnings: TBD")
    
    # NOTE: Manual confirmation needed for finish/winnings until ESPN API confirmed
    logger.info(f"=== CLOSE COMPLETE for {tournament_name} ===")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--tournament", required=True)
    parser.add_argument("--pick", help="Player canonical ID")
    parser.add_argument("--finish", type=int, help="Finish position")
    parser.add_argument("--winnings", type=float, help="Winnings amount")
    args = parser.parse_args()
    
    if args.pick and args.finish and args.winnings:
        # Direct entry mode
        append_entry(args.tournament, args.pick, args.finish, args.winnings)
        mark_burned(args.pick)
        logger.info(f"Logged: {args.tournament} | {args.pick} | {args.finish} | ${args.winnings:,.0f}")
    else:
        close_tournament(args.tournament)