from normalize.events import CANONICAL_EVENTS, get_upcoming
from normalize.join import build_player_event_record, build_all_player_records
from fetchers.odds import get_draftkings_odds, american_to_implied

logger = logging.getLogger(__name__)

WEIGHTS = {
    "course_fit": 0.35,
    "recent_form": 0.25,
    "course_history": 0.20,
    "field_strength": 0.10,
    "situational": 0.10,
}

