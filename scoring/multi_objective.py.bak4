"""
Multi-objective scoring engine for golf pick recommendations.

Weights from PROMPT.md:
  course_fit      35%
  recent_form     25%
  course_history  20%
  field_strength  10%
  situational     10%
"""

import logging
import os
import sys
from datetime import date
from typing import Optional

